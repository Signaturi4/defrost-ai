  "(^|/)(Desktop|Documents|Downloads)(/|$)",
  "(^|/)Dropbox[^/]*(/|$)",
  "(^|/)Library/Mobile Documents(/|$)",
  "(^|/)client-memory(/|$)",
  "(^|/)recsys-docs(/|$)",
  "(^|/)db_schema(/|$)",
  "Documents/Main",
  "(^|/)\\.kev-memory(/|$)",
  "(^|/)[^/]*-export(/|$)"
 ],
