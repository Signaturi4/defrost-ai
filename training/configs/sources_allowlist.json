  "{repo}/benchmarks/heldout/questions.jsonl",
  "{repo}/benchmarks/books/questions.jsonl",
  "{repo}/benchmarks/e2e/questions.jsonl",
  "~/heldout-memory/text_kb.sqlite",
  "~/books-memory/text_kb.sqlite",
  "~/.kev-memory/parity-heldout/knowledge.sqlite",
  "~/.kev-memory/benchmark-books/knowledge.sqlite",
  "~/.kev-memory/e2e/knowledge.sqlite"
 ],
