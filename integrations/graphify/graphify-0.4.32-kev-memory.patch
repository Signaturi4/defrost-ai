+# kev-memory integration: hybrid-RAG knowledge memory next to the graph (stdlib only; talks to the kev-memory service)
+"""graphify memory — a searchable, cited knowledge memory built next to the code graph.
+
+graphify builds the structural graph (AST, 0 tokens). kev-memory adds the text side: every doc section is indexed
+with BM25 + Kev-Ret-B vectors, re-ranked by Kev-Rerank when needed, and linked to the code nodes it names. On the
+locked benchmarks this beats a plain BM25 section index by +0.10-0.12 nDCG@10 and +0.09-0.10 RAGAS (NVIDIA metrics).
+
+The models run in a resident service (`kev-memory serve`, started on demand), so this module has no ML dependencies.
+
+    graphify memory init [PATH] [--domain NAME]     create a workspace for a repo/folder and build its memory
+    graphify memory build WORKSPACE.json --domain NAME
+    graphify memory update DOMAIN [--wait]          rebuild after changes (incremental; new/edited sections only)
+    graphify memory search "question" [--domain D]... [--mode fast|rerank|...] [-k 5|auto] [--json]
+    graphify memory domains | status
+    graphify memory rollback DOMAIN                 restore the previous build
+
+`graphify memory init` also writes graphify-out/kev-memory.json; after that, graphify's own git hooks
+(`graphify hook install`) refresh the memory after every commit and branch switch, right after the code graph.
+
+Environment: KEV_MEMORY_URL (default http://127.0.0.1:8765), KEV_MEMORY_SERVE_CMD (default "kev-memory serve"),
+KEV_MEMORY_DOMAINS (default domains for search, comma-separated; default: all)."""
+from __future__ import annotations
+
+import json
+import os
+import shlex
+import subprocess
+import sys
+import time
+import urllib.error
+import urllib.request
+from pathlib import Path
+
+URL = os.environ.get("KEV_MEMORY_URL", "http://127.0.0.1:8765")
+SERVE_CMD = os.environ.get("KEV_MEMORY_SERVE_CMD", "kev-memory serve")
+HOME = Path(os.environ.get("KEV_MEMORY_HOME", "~/.kev-memory")).expanduser()
+MODES = ["fast", "rerank", "hybrid", "dense", "bm25", "all"]
+
+
+# ---- service client ------------------------------------------------------------------------------------------------
+def _call(method: str, path: str, body: dict | None = None, timeout: float = 900):
+    req = urllib.request.Request(URL + path, method=method, data=None if body is None else json.dumps(body).encode(),
+                                 headers={"Content-Type": "application/json"})
+    try:
+        with urllib.request.urlopen(req, timeout=timeout) as r:
+            return json.loads(r.read())
+    except urllib.error.HTTPError as e:
+        raise RuntimeError(json.loads(e.read() or b"{}").get("error", str(e))) from None
+
+
+def alive() -> bool:
+    try:
+        return bool(_call("GET", "/health", timeout=2).get("ok"))
+    except (OSError, RuntimeError):
+        return False
+
+
+def ensure_service(wait: float = 180) -> None:
+    if alive():
+        return
+    HOME.mkdir(parents=True, exist_ok=True)
+    log = open(HOME / "service.log", "a")
+    port = URL.rsplit(":", 1)[-1]
+    subprocess.Popen(shlex.split(SERVE_CMD) + ["--port", port], stdout=log, stderr=log, start_new_session=True)
+    t0 = time.time()
+    while time.time() - t0 < wait:
+        if alive():
+            return
+        time.sleep(1)
+    raise RuntimeError(f"kev-memory service did not start ({SERVE_CMD}); see {HOME / 'service.log'}")
+
+
+DEFAULT_DOMAINS = [d for d in os.environ.get("KEV_MEMORY_DOMAINS", "").split(",") if d]
+
+
+def search(query: str, domains=None, mode: str = "fast", k: int | str = 5) -> dict:
+    """domains: None -> KEV_MEMORY_DOMAINS (comma-separated) if set, else every registered domain."""
+    ensure_service()
+    domains = domains or DEFAULT_DOMAINS or None
+    return _call("POST", "/search", {"query": query, "domains": domains, "mode": mode, "k": k, "context": True})
+
+
+def domains() -> dict:
+    ensure_service()
+    return _call("GET", "/domains")
+
+
+def update(domain: str | None = None, workspace: str | None = None, wait: bool = True, description: str = "") -> dict:
+    ensure_service()
+    job = _call("POST", "/update", {"domain": domain, "workspace": workspace, "description": description})
+    if not wait:
+        return job
+    while True:
+        state = _call("GET", f"/jobs/{job['job']}")
+        if state["state"] in ("done", "failed"):
+            return state
+        time.sleep(2)
+
+
+def rollback(domain: str) -> dict:
+    ensure_service()
+    return _call("POST", "/rollback", {"domain": domain})
+
+
+# ---- workspace + hook -----------------------------------------------------------------------------------------------
+def init_workspace(path: Path, name: str) -> Path:
+    """One-component workspace for a repo or folder; memory written to ~/.kev-memory/<name> (never inside the repo)."""
+    path = path.resolve()
+    ws = {"name": name, "out": str(HOME / name), "components": [{"name": name, "path": str(path)}]}
+    f = HOME / f"{name}.workspace.json"
+    HOME.mkdir(parents=True, exist_ok=True)
+    f.write_text(json.dumps(ws, indent=1))
+    return f
+
+
+MARKER = Path("graphify-out") / "kev-memory.json"
+
+
+def write_marker(repo: Path, domain: str, workspace: Path) -> Path:
+    """graphify-out/kev-memory.json tells graphify's own git hooks (graphify hook install) to refresh this domain."""
+    f = repo / MARKER
+    f.parent.mkdir(parents=True, exist_ok=True)
+    f.write_text(json.dumps({"domain": domain, "workspace": str(workspace)}, indent=1))
+    return f
+
+
+def refresh_from_hook(repo: Path) -> None:
+    """Called by graphify's post-commit / post-checkout hook after the code graph rebuild: queue a background
+    memory update for the domain named in graphify-out/kev-memory.json. Never blocks and never fails the commit."""
+    f = repo / MARKER
+    if not f.exists():
+        return
+    domain = json.loads(f.read_text())["domain"]
+    HOME.mkdir(parents=True, exist_ok=True)
+    log = open(HOME / "hook.log", "a")
+    subprocess.Popen([sys.executable, "-m", "graphify", "memory", "update", domain, "--no-wait"], stdout=log,
+                     stderr=log, start_new_session=True)            # detached: the service may need to start first
+    print(f"[graphify hook] memory update queued for '{domain}' (log {HOME / 'hook.log'})")
+
+
+# ---- MCP tools (registered by graphify.serve) ------------------------------------------------------------------------
+MCP_TOOLS = [
+    {"name": "memory_search",
+     "description": "Search the knowledge memory: documentation sections of every registered domain, each with the "
+                    "code it names, cited as domain:path:Lstart-end. mode: fast (default), rerank (most accurate), "
+                    "dense (paraphrased how/why), bm25 (exact identifiers, error strings).",
+     "inputSchema": {"type": "object", "properties": {
+         "query": {"type": "string"},
+         "domains": {"type": "array", "items": {"type": "string"}},
+         "mode": {"type": "string", "enum": MODES, "default": "fast"},
+         "k": {"type": ["integer", "string"], "default": 5,
+               "description": "number of sections, or \"auto\": 1-5 from the retriever's calibrated confidence"}},
+         "required": ["query"]}},
+    {"name": "memory_domains", "description": "List knowledge-memory domains with sources, build time and counts.",
+     "inputSchema": {"type": "object", "properties": {}}},
+    {"name": "memory_update",
+     "description": "Rebuild a domain's memory from its sources now (incremental). Use after docs or code changed.",
+     "inputSchema": {"type": "object", "properties": {"domain": {"type": "string"}}, "required": ["domain"]}},
+]
+
+
+def _k(v):
+    return "auto" if v == "auto" else int(v)
+
+
+def mcp_call(name: str, args: dict) -> str:
+    if name == "memory_search":
+        res = search(args["query"], args.get("domains"), args.get("mode", "fast"), _k(args.get("k", 5)))
+        return f"mode {res['mode']} -> {res['mode_used']}\n\n{res.get('context') or 'no results'}"
+    if name == "memory_domains":
+        return json.dumps(domains(), indent=1)
+    if name == "memory_update":
+        res = update(args["domain"], wait=True)
+        if res.get("state") == "done":
+            m = res["manifest"]
+            return json.dumps({"state": "done", "counts": m["counts"], "changed": m["changed"]["n"],
+                               "seconds": res.get("seconds")}, indent=1)
+        return json.dumps({"state": res.get("state"), "error": res.get("error")}, indent=1)
+    raise KeyError(name)
+
+
+# ---- CLI ------------------------------------------------------------------------------------------------------------
+def _print_search(res: dict, as_json: bool):
+    if as_json:
+        print(json.dumps(res, indent=1))
+    else:
+        print(f"mode {res['mode']} -> {res['mode_used']}\n")
+        print(res.get("context") or "no results")
+
+
+def cli(argv: list[str]) -> int:
+    import argparse
+    ap = argparse.ArgumentParser(prog="graphify memory", description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    i = sub.add_parser("init"); i.add_argument("path", nargs="?", default="."); i.add_argument("--domain")
+    i.add_argument("--description", default="")
+    b = sub.add_parser("build"); b.add_argument("workspace"); b.add_argument("--domain", required=True)
+    b.add_argument("--description", default="")
+    u = sub.add_parser("update"); u.add_argument("domain"); u.add_argument("--no-wait", action="store_true")
+    s = sub.add_parser("search"); s.add_argument("query"); s.add_argument("--domain", action="append")
+    s.add_argument("--mode", default="fast", choices=MODES); s.add_argument("-k", type=_k, default=5)
+    s.add_argument("--json", action="store_true")
+    sub.add_parser("domains"); sub.add_parser("status")
+    r = sub.add_parser("rollback"); r.add_argument("domain")
+    a = ap.parse_args(argv)
+    try:
+        if a.cmd == "init":
+            path = Path(a.path)
+            name = a.domain or path.resolve().name.lower().replace(" ", "-")
+            ws = init_workspace(path, name)
+            print(f"workspace {ws}; building memory '{name}' ...")
+            res = update(name, str(ws), wait=True, description=a.description)
+            print(json.dumps({k: res.get(k) for k in ("state", "seconds", "error")} |
+                             ({"counts": res["manifest"]["counts"]} if res.get("manifest") else {}), indent=1))
+            print(f"marker {write_marker(path.resolve(), name, ws)}; run `graphify hook install` to refresh on commit")
+        elif a.cmd == "build":
+            res = update(a.domain, str(Path(a.workspace).resolve()), wait=True, description=a.description)
+            print(json.dumps({k: v for k, v in res.items() if k not in ("log",)}, indent=1, default=str)[:4000])
+        elif a.cmd == "update":
+            res = update(a.domain, wait=not a.no_wait)
+            print(json.dumps({k: v for k, v in res.items() if k != "log"}, indent=1, default=str)[:4000])
+        elif a.cmd == "search":
+            _print_search(search(a.query, a.domain, a.mode, a.k), a.json)
+        elif a.cmd == "domains":
+            print(json.dumps(domains(), indent=1))
+        elif a.cmd == "status":
+            print(json.dumps({"service": URL, "alive": alive(), "domains": domains() if alive() else None}, indent=1))
+        elif a.cmd == "rollback":
+            print(json.dumps(rollback(a.domain)))
+    except RuntimeError as e:
+        print(f"error: {e}", file=sys.stderr)
+        return 1
+    return 0
